# config/prod.env
# Production environment
# NO default values here — all secrets MUST come from the secrets manager.
# Deploying with missing values will cause startup to fail visibly.

APP_ENV=prod

KAFKA_BOOTSTRAP_SERVERS=${PROD_KAFKA_BOOTSTRAP_SERVERS}
POSTGRES_HOST=${PROD_POSTGRES_HOST}
POSTGRES_PORT=5432
POSTGRES_DB=insurance_lineage
POSTGRES_USER=pipeline_admin
POSTGRES_PASSWORD=${PROD_DB_PASSWORD}

MINIO_ENDPOINT=${PROD_MINIO_ENDPOINT}
MINIO_ACCESS_KEY=${PROD_MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${PROD_MINIO_SECRET_KEY}
MINIO_BUCKET=insurance-claims-lake
MINIO_USE_SSL=true

JAEGER_ENDPOINT=${PROD_JAEGER_ENDPOINT}
PROMETHEUS_PORT=8000
API_HOST=0.0.0.0
API_PORT=8080

CLAIMS_BATCH_SIZE=200
PROCESSING_INTERVAL_SECONDS=5

# Production SLOs — strict
SLO_VALIDATION_LATENCY_P95_MS=500
SLO_FRAUD_LATENCY_P95_MS=1000
SLO_ENRICHMENT_LATENCY_P95_MS=2000
SLO_PIPELINE_LATENCY_P95_MS=5000
SLO_MAX_ERROR_RATE=0.02
SLO_MAX_DLQ_RATE=0.01
SLO_MIN_THROUGHPUT_PER_SEC=5.0
SLO_MIN_LINEAGE_COVERAGE_PCT=95.0
SLO_MIN_DQ_COMPLETENESS=0.98
SLO_MIN_DQ_VALIDITY=0.95
SLO_MIN_DQ_TIMELINESS=0.98
