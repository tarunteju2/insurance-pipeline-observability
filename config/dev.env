# config/dev.env
# Development environment — local Docker Compose defaults
# These are NOT secrets; they are development-only defaults.
# Copy this file to .env in the project root or source it before running.

APP_ENV=dev

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insurance_lineage
POSTGRES_USER=pipeline_admin
POSTGRES_PASSWORD=devpass_not_for_prod

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=devminio_not_for_prod
MINIO_BUCKET=insurance-claims-lake
MINIO_USE_SSL=false

JAEGER_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=8000
API_HOST=0.0.0.0
API_PORT=8080

CLAIMS_BATCH_SIZE=50
PROCESSING_INTERVAL_SECONDS=5

# SLO overrides for dev (more lenient)
SLO_VALIDATION_LATENCY_P95_MS=2000
SLO_FRAUD_LATENCY_P95_MS=3000
SLO_MIN_THROUGHPUT_PER_SEC=0.1
