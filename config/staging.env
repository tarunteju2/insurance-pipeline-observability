# config/staging.env
# Staging environment — mirrors production topology, uses test data
# Secrets must be injected via CI/CD or a secrets manager; do NOT commit real values here.

APP_ENV=staging

KAFKA_BOOTSTRAP_SERVERS=kafka-staging.internal:9092
POSTGRES_HOST=postgres-staging.internal
POSTGRES_PORT=5432
POSTGRES_DB=insurance_lineage_staging
POSTGRES_USER=pipeline_admin
POSTGRES_PASSWORD=${STAGING_DB_PASSWORD}    # injected by CI

MINIO_ENDPOINT=minio-staging.internal:9000
MINIO_ACCESS_KEY=${STAGING_MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${STAGING_MINIO_SECRET_KEY}
MINIO_BUCKET=insurance-claims-lake-staging
MINIO_USE_SSL=true

JAEGER_ENDPOINT=http://jaeger-staging.internal:4317
PROMETHEUS_PORT=8000
API_HOST=0.0.0.0
API_PORT=8080

CLAIMS_BATCH_SIZE=100
PROCESSING_INTERVAL_SECONDS=5

# SLO targets — same as production so staging catches regressions
SLO_VALIDATION_LATENCY_P95_MS=500
SLO_FRAUD_LATENCY_P95_MS=1000
SLO_PIPELINE_LATENCY_P95_MS=5000
SLO_MAX_ERROR_RATE=0.05
SLO_MIN_THROUGHPUT_PER_SEC=1.0
SLO_MIN_DQ_COMPLETENESS=0.95
SLO_MIN_DQ_VALIDITY=0.90
