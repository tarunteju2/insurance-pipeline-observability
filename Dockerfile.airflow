FROM apache/airflow:2.11.1-python3.11

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && apt-get clean

USER airflow

# Copy requirements (py311-specific lockfile for deterministic builds)
COPY requirements.txt requirements_airflow.txt requirements-py311.txt /tmp/

# Install Python dependencies (use py311 lockfile for Airflow 2.11.1)
RUN pip install --no-cache-dir \
    -r /tmp/requirements-py311.txt \
    -r /tmp/requirements_airflow.txt

# Copy project code
COPY --chown=airflow:airflow src /opt/airflow/src
COPY --chown=airflow:airflow dags /opt/airflow/dags
COPY --chown=airflow:airflow scripts /opt/airflow/scripts

# Set PYTHONPATH
ENV PYTHONPATH=/opt/airflow

WORKDIR /opt/airflow
